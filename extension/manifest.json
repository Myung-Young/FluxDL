{
  "manifest_version": 3,
  "name": "FluxDL Remote",
  "version": "1.0.0",
  "description": "Send links to FluxDL on this computer. Loopback only — nothing leaves your PC.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to FluxDL"
  }
}
