{
  "name": "@grabber/desktop",
  "version": "1.8.1",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src e2e --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "soak: idle": "node scripts/soak.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@grabber/core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "app.fluxdl.desktop",
    "productName": "FluxDL",
    "forceCodeSigning": false,
    "directories": {
      "output": "../../release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/icons/tray.png",
        "to": "icons/tray.png"
      },
      {
        "from": "resources/icons/overlay-dot.png",
        "to": "icons/overlay-dot.png"
      }
    ],
    "win": {
      "icon": "resources/icons/app.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "FluxDL-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "fluxdl",
        "name": "FluxDL link list",
        "description": "Links file opened into the Batch panel"
      }
    ],
    "portable": {
      "artifactName": "FluxDL-Portable-${version}.${ext}"
    }
  }
}
